APP_NAME="Masofaviy taʼlim tizimi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Sayt manzili. Domen ildizida: https://mt.regofis.uz
# Yo'lda (boshqa sayt ichida): https://dist.karsu.uz/zoom — bunda SESSION_PATH=/zoom.
# deploy/deploy.sh frontendni shu yo'l uchun o'zi yig'adi (docs/ORNATISH.md, 7-bo'lim).
APP_URL=https://dist.karsu.uz/zoom
FRONTEND_URL=https://dist.karsu.uz/zoom
APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=kaa
APP_UNIVERSITY="Qoraqalpoq davlat universiteti"

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mt_allpro
DB_USERNAME=mt_allpro
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
# Sayt yo'lda ishlasa — o'sha yo'l (cookie'lar dist.karsu.uz dagi boshqa saytlarga yuborilmaydi).
SESSION_PATH=/zoom
# Bir domendagi boshqa Laravel ilovalari bilan cookie nomi to'qnashmasligi uchun.
SESSION_COOKIE=karsu_zoom_session

# Sayt ochilgan domen avtomatik qabul qilinadi. Bu yerga faqat qo'shimcha
# domenlar yoziladi (port bilan). Ishlab chiqishda: localhost:5173,127.0.0.1:5173
SANCTUM_STATEFUL_DOMAINS=

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- HEMIS OAuth (xodimlar kirishi) ---
HEMIS_BASE_URL=https://hemis.karsu.uz
HEMIS_CLIENT_ID=
HEMIS_CLIENT_SECRET=
HEMIS_REDIRECT_URI="${APP_URL}/auth/hemis/callback"
HEMIS_UNIVERSITY_ID=
HEMIS_ALLOWED_TYPES=employee
HEMIS_AUTO_REGISTER=true

# --- Telegram bot (ixtiyoriy) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Tasodifiy uzun qator: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- HEMIS REST API (talabalar F.I.Sh. va rasmi, "HEMIS SYNC") ---
# Tekshirish: php artisan hemis:student <HEMIS ID>
HEMIS_API_URL=https://student.karsu.uz/rest
HEMIS_API_TOKEN=
HEMIS_STUDENT_ENDPOINT=v1/data/student-list
HEMIS_STUDENT_SEARCH_PARAM=search

# --- Video yozuvlar (Zoom bulutidan ko'chiriladi) ---
RECORDINGS_PATH=/var/www/recordings
RECORDINGS_MIN_FREE_GB=5
# Videoni nginx beradi, PHP faqat ruxsatni tekshiradi (deploy/nginx/*.conf dagi /_zoom_recordings/).
# Bo'sh qoldirilsa, fayl PHP orqali beriladi.
RECORDINGS_ACCEL_PREFIX=/_zoom_recordings/

# dist.karsu.uz proksi qiladi (variant B) — dist.karsu.uz serverining IP manzili.
# Noto'g'ri bo'lsa, `php artisan app:check` to'g'ri IP'ni ko'rsatadi.
TRUSTED_PROXIES=127.0.0.1

LESSON_DEFAULT_DURATION=80

# --- Eski bazadan ko'chirish (faqat bir marta: php artisan legacy:import) ---
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
