APP_NAME="Masofaviy taʼlim tizimi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mt.allpro.uz
FRONTEND_URL=https://mt.allpro.uz
APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=kaa
APP_UNIVERSITY="Qoraqalpoq davlat universiteti"

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mt_allpro
DB_USERNAME=mt_allpro
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

# Frontend domeni (port bilan). Ishlab chiqishda: localhost:5173
SANCTUM_STATEFUL_DOMAINS=mt.allpro.uz

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- HEMIS OAuth (xodimlar kirishi) ---
HEMIS_BASE_URL=https://hemis.karsu.uz
HEMIS_CLIENT_ID=
HEMIS_CLIENT_SECRET=
HEMIS_REDIRECT_URI="${APP_URL}/auth/hemis/callback"
HEMIS_UNIVERSITY_ID=
HEMIS_ALLOWED_TYPES=employee
HEMIS_AUTO_REGISTER=true

# --- Telegram bot (ixtiyoriy) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Tasodifiy uzun qator: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

LESSON_DEFAULT_DURATION=80

# --- Eski bazadan ko'chirish (faqat bir marta: php artisan legacy:import) ---
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
